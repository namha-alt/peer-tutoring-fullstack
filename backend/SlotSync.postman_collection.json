    {
      "name": "Step 03: Tutor Slot Management (Topics 37, 38, 41)",
      "item": [
        {
          "name": "07 - Update Tutor Slot Capacity (PUT /api/users/tutor/capacity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maxCapacity\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/tutor/capacity", "host": ["{{baseUrl}}"], "path": ["api", "users", "tutor", "capacity"] }
          }
        },
        {
          "name": "08 - Tutor Publishes Availability Slot (POST /api/slots/toggle)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created or 200 Removed', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.environment.set('slotId', res.data.id);",
                  "  console.log('Saved slotId to environment:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-10-23\",\n  \"startHour\": 15\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/slots/toggle", "host": ["{{baseUrl}}"], "path": ["api", "slots", "toggle"] }
          }
        },
        {
          "name": "09 - Get Tutor My Slots (GET /api/slots/my)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.environment.set('slotId', res.data[0].id || res.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tutorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/slots/my", "host": ["{{baseUrl}}"], "path": ["api", "slots", "my"] }
