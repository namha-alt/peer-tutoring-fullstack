                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/tutors", "host": ["{{baseUrl}}"], "path": ["api", "users", "tutors"] }
          }
        },
        {
          "name": "12 - Browse Available Calendar Slots (GET /api/slots/available)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "  const studentId = pm.environment.get('studentId') || ''; const openSlot = res.data.find(s => !s.isFull && (!s.activeBookings || !s.activeBookings.some(b => b.studentId === studentId))) || res.data.find(s => !s.isFull) || res.data[0];",
                  "  pm.environment.set('slotId', openSlot.id || openSlot._id);",
                  "  pm.environment.set('slotDate', openSlot.date);",
                  "  console.log('Saved open slotId:', openSlot.id, 'date:', openSlot.date);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/slots/available", "host": ["{{baseUrl}}"], "path": ["api", "slots", "available"] }
          }
        },
        {
          "name": "13 - Upload Study Material via Multer (POST /api/files/upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 200', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const res = pm.response.json();",
                  "if (res.file) {",
                  "  pm.environment.set('attachmentUrl', res.file.fileUrl);",
                  "  pm.environment.set('attachmentOriginalName', res.file.originalName);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "material",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/files/upload", "host": ["{{baseUrl}}"], "path": ["api", "files", "upload"] }
          }
        },
        {
          "name": "14 - Student Submits Booking Request (POST /api/bookings)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.environment.set('bookingId', res.data.id);",
                  "  console.log('Saved bookingId to environment:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"date\": \"{{slotDate}}\",\n  \"topic\": \"Calculus Midterm Optimization Problems\",\n  \"specifics\": \"Need help solving problem set #4 and practicing chain rule derivatives.\",\n  \"attachmentUrl\": \"{{attachmentUrl}}\",\n  \"attachmentOriginalName\": \"{{attachmentOriginalName}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "15 - Conflict Validation: Duplicate Request (Expect 400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error message specifies already booked or limit', function () { pm.expect(pm.response.json().success).to.be.false; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"date\": \"{{slotDate}}\",\n  \"topic\": \"Duplicate Request Attempt\",\n  \"specifics\": \"This request should be rejected by server validation.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "16 - Get Student Bookings (Mongoose Populate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
