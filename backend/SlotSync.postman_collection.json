{
  "info": {
    "name": "SlotSync REST API Collection (Node.js + Express + MongoDB)",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Simplified, beginner-friendly Postman test suite covering user authentication, tutor slot management, booking requests, conflict validation, and approval workflows against MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01: System Health",
      "item": [
        {
          "name": "01 - System Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('MongoDB is Connected', function () { pm.expect(pm.response.json().database.state).to.eql('Connected'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/system/health", "host": ["{{baseUrl}}"], "path": ["api", "system", "health"] }
          }
        }
      ]
    },
    {
      "name": "02: Authentication & Security",
      "item": [
        {
          "name": "02 - Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created or 400 Already Exists', function () { pm.expect([201, 400]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Williams\",\n  \"email\": \"alice@student.edu\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "03 - Login as Tutor (Auto-sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.environment.set('authToken', res.token);",
                  "  pm.environment.set('tutorToken', res.token);",
                  "  pm.environment.set('tutorId', res.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@tutors.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "04 - Access Protected Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('User is authenticated', function () { pm.expect(pm.response.json().user.email).to.exist; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "03: Tutor Slot Management",
      "item": [
        {
          "name": "05 - Update Tutor Capacity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maxCapacity\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/tutor/capacity", "host": ["{{baseUrl}}"], "path": ["api", "users", "tutor", "capacity"] }
          }
        },
        {
          "name": "06 - Tutor Publishes Availability Slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 201', function () { pm.expect([200, 201]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-11-20\",\n  \"startHour\": 15\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/slots/toggle", "host": ["{{baseUrl}}"], "path": ["api", "slots", "toggle"] }
          }
        },
        {
          "name": "07 - Get Tutor's Own Slots",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Slots array is returned', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tutorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/slots/my", "host": ["{{baseUrl}}"], "path": ["api", "slots", "my"] }
          }
        }
      ]
    },
    {
      "name": "04: Student Discovery & Booking",
      "item": [
        {
          "name": "08 - Login as Student (Auto-sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.environment.set('authToken', res.token);",
                  "  pm.environment.set('studentToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@student.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "09 - Browse Qualified Tutors",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tutors array returned', function () { pm.expect(pm.response.json().data.length).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/tutors", "host": ["{{baseUrl}}"], "path": ["api", "users", "tutors"] }
          }
        },
        {
          "name": "10 - Browse Available Calendar Slots",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "  const unbooked = res.data.find(s => !s.isFull) || res.data[0];",
                  "  pm.environment.set('slotId', unbooked.id);",
                  "  pm.environment.set('slotDate', unbooked.date);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/slots/available", "host": ["{{baseUrl}}"], "path": ["api", "slots", "available"] }
          }
        },
        {
          "name": "11 - Student Submits Booking Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 400 Conflict', function () { pm.expect([201, 400]).to.include(pm.response.code); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.environment.set('bookingId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"date\": \"{{slotDate}}\",\n  \"topic\": \"Calculus Derivatives\",\n  \"specifics\": \"Need step by step help on practice problems\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "12 - Conflict Validation: Duplicate Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Returns clear conflict error message', function () { pm.expect(pm.response.json().message).to.exist; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"date\": \"{{slotDate}}\",\n  \"topic\": \"Calculus Derivatives (Duplicate Attempt)\",\n  \"specifics\": \"Checking duplicate conflict detection\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "13 - Get Student's Own Bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Bookings array returned', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/my", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "my"] }
          }
        }
      ]
    },
    {
      "name": "05: Tutor Decision & Cancellation",
      "item": [
        {
          "name": "14 - Tutor Approves Booking Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status updated to confirmed', function () { pm.expect(pm.response.json().data.status).to.eql('confirmed'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "status"] }
          }
        },
        {
          "name": "15 - Student Cancels Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK or 400 Inactive', function () { pm.expect([200, 400]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"Resolved question on my own\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "cancel"] }
          }
        },
        {
          "name": "16 - Unauthorized Access Test (No Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });",
                  "pm.test('Rejection message returned', function () { pm.expect(pm.response.json().message).to.exist; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    }
  ]
}
